# Control Plane API
# Address the REST API server listens on
CONTROL_PLANE_REST_ADDR=:8080

# Address the gRPC server listens on (for node agents)
CONTROL_PLANE_GRPC_ADDR=:9090

# etcd embedded data directory
ETCD_DATA_DIR=./data/etcd

# etcd peer/client listen URLs (embedded single-node)
ETCD_LISTEN_CLIENT_URLS=http://localhost:2379
ETCD_LISTEN_PEER_URLS=http://localhost:2380
ETCD_ADVERTISE_CLIENT_URLS=http://localhost:2379

# Node Agent Configuration
# Address of the control plane REST API (used by node agent)
AGENT_CONTROL_PLANE_REST_ADDR=http://localhost:8080

# Address of the control plane gRPC API (used by node agent)
AGENT_CONTROL_PLANE_GRPC_ADDR=localhost:9090

# Unique identifier for this node (auto-generated if omitted)
AGENT_NODE_ID=

# Human-readable name for this node
AGENT_NODE_NAME=worker-1

# Address advertised to the control plane so it can route back to this agent
AGENT_ADVERTISE_ADDR=127.0.0.1

# Docker daemon socket path
DOCKER_HOST=unix:///var/run/docker.sock

# Controller Manager
# How often control loops run (seconds)
CONTROLLER_LOOP_INTERVAL_SECONDS=10

# Heartbeat threshold — node marked offline after this many seconds of silence
NODE_HEARTBEAT_TIMEOUT_SECONDS=30

# Scheduler
# Cluster-wide CIDR for container IP allocation (Phase 6 networking)
CLUSTER_CIDR=10.100.0.0/16

# CLI
# Control plane REST endpoint used by the CLI tool
CLI_API_ENDPOINT=http://localhost:8080

# Logging
# Log level: debug | info | warn | error
LOG_LEVEL=info
